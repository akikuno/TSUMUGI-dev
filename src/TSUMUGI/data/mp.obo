property_value: dc:date "2020-07-07T12:25:03Z" xsd:dateTime

[Term]
id: MP:0031116
name: microvesicular hepatic steatosis
def: "a less common form of hepatic steatosis characterized by accumulation of multiple small lipid droplets giving the cytoplasm a foamy appearance without displacing the nucleus in affected hepatocytes; causes include tetracyclines, acute fatty liver of pregnancy, Reye's syndrome, and hepatitis C" [https://en.wikipedia.org/wiki/Steatosis, ISBN:978-0-323-37591-7]
synonym: "microvesicular steatosis" EXACT []
synonym: "small droplet steatosis" EXACT []
is_a: MP:0002628 ! hepatic steatosis
