property_value: dc:date "2018-10-10T10:39:39Z" xsd:dateTime

[Term]
id: MP:0030858
name: small olecranon
def: "size reduction of the large bony prominence at the proximal end of the ulna which articulates with the olecranon fossa of the humerus and is palpable at the posterior aspect of the elbow" [https://orcid.org/0000-0002-6490-7723]
synonym: "decreased olecranon size" EXACT []
synonym: "reduced olecranon process" RELATED []
synonym: "reduced olecranon size" EXACT []
