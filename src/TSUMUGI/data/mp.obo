property_value: dc:date "2017-12-11T11:45:11Z" xsd:dateTime

[Term]
id: MP:0030497
name: short tooth root
def: "decreased length of the part of a tooth that is implanted in the gum; the root is located below the neck of the tooth, covered by cementum rather than enamel, and attached by the periodontal ligament to the alveolar bone" [https://orcid.org/0000-0002-6490-7723]
synonym: "decreased length of dental root" EXACT []
synonym: "decreased length of tooth root" EXACT []
