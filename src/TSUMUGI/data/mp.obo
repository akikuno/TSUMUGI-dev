property_value: dc:creator https://orcid.org/0000-0002-6490-7723
property_value: dc:date "2018-10-15T12:39:04Z" xsd:dateTime

[Term]
id: MP:0030866
name: abnormal synovial joint membrane morphology
def: "any structural anomaly of the connective tissue membrane that lines the cavity of a synovial joint and produces the synovial fluid; it lines all internal surfaces of the cavity except for the articular cartilage of the bones" [https://medical-dictionary.thefreedictionary.com/synovial+membrane, ISBN:978-0-323-07954-9, UBERON:0002018]
synonym: "abnormal stratum synoviale morphology" EXACT []
synonym: "abnormal synovial joint lining morphology" EXACT []
