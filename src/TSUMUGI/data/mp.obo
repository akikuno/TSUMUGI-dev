synonym: "extended somite segmentation clock period" EXACT []
synonym: "prolonged period of somite formation" EXACT []
synonym: "prolonged somitogenesis period" EXACT []
is_a: MP:0012669 ! abnormal somite segmentation clock
property_value: terms:contributor https://orcid.org/0000-0003-3691-0324
created_by: csmith
creation_date: 2014-01-05T23:33:48Z

