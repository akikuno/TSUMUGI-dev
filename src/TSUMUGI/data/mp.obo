is_a: MP:0003933 ! abnormal cementum morphology
property_value: dc:creator https://orcid.org/0000-0002-6490-7723
property_value: dc:date "2018-01-19T15:10:32Z" xsd:dateTime

[Term]
id: MP:0030548
name: abnormal cementoid morphology
def: "any structural anomaly of the organic matrix secreted by cementoblasts, which forms the most recent unmineralized layer covering the surface of cellular cementum" [https://books.google.com/books?isbn=0323058442, https://medicine.academic.ru/110777/cementoid, PMID:27029548]
synonym: "abnormal pre-cementum morphology" EXACT []
synonym: "abnormal uncalcified cementum morphology" EXACT []
