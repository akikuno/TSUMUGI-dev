created_by: csmith
creation_date: 2014-01-02T12:43:46Z

[Term]
id: MP:0012542
name: abnormal neuropore morphology
def: "any structural anomaly of either the anterior or posterior temporary opening leading from the central canal of the embryonic neural tube to the exterior; the anterior and posterior neuropores connect the lumen of the neural tube with the amniotic cavity" [https://orcid.org/0000-0002-6490-7723]
is_a: MP:0002151 ! abnormal neural tube morphology
property_value: terms:contributor https://orcid.org/0000-0003-3691-0324
created_by: csmith
creation_date: 2014-01-02T13:20:22Z

[Term]
id: MP:0012543
name: abnormal rostral neuropore morphology
def: "any structural anomaly of the temporary opening at the extreme rostral (cephalic) end of the early embryonic prosencephalon (forebrain); the anterior neuropore appears before the process of neural tube closure is complete" [https://orcid.org/0000-0002-6490-7723]
synonym: "abnormal anterior neuropore morphology" EXACT []
synonym: "abnormal cephalic neuropore morphology" EXACT []
synonym: "abnormal cranial neuropore morphology" EXACT []
is_a: MP:0012542 ! abnormal neuropore morphology
property_value: terms:contributor https://orcid.org/0000-0003-3691-0324
created_by: csmith
creation_date: 2014-01-02T13:21:16Z

[Term]
id: MP:0012544
name: abnormal caudal neuropore morphology
def: "any structural anomaly of the temporary opening at the extreme caudal end of the neural tube in early embryos; the posterior neuropore appears before the process of neural tube closure is complete" [https://orcid.org/0000-0002-6490-7723]
synonym: "abnormal posterior neuropore morphology" EXACT []
is_a: MP:0012542 ! abnormal neuropore morphology
property_value: terms:contributor https://orcid.org/0000-0003-3691-0324
created_by: csmith
